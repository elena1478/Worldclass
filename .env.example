# ============================================================
# Worldclass Booking Automation - Configuration Template
# Copy this file to .env and fill in your credentials
# ============================================================

# Contul tau Worldclass
WC_EMAIL=email@exemplu.ro
WC_PASSWORD=parola_worldclass

# --- Setari Optionale ---
# Cat de des verifica clase noi (in minute, default: 30)
CHECK_INTERVAL_MINUTES=30

# false = afiseaza browserul (util pentru debug), true = ruleaza in fundal
HEADLESS=true
