# ============================================================
# Worldclass Booking Automation - Configuration Template
# Copy this file to .env and fill in your credentials
# ============================================================

# --- Worldclass Account ---
WC_EMAIL=email@exemplu.ro
WC_PASSWORD=parola_worldclass

# --- Email Notificari ---
# Adresa la care primesti confirmarea rezervarilor
NOTIFY_EMAIL=email@exemplu.ro

# Setari SMTP pentru trimiterea emailurilor
# Gmail: folositi o parola de aplicatie (nu parola contului)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASSWORD=parola_aplicatie_gmail

# --- Setari Optionale ---
# Cat de des verifica clase noi (in minute, default: 30)
CHECK_INTERVAL_MINUTES=30

# Ruleaza browserul in fundal (true = fara fereastra, false = cu fereastra - util pentru debug)
HEADLESS=true
